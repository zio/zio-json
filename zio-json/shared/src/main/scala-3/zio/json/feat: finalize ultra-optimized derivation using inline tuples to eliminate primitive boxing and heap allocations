package zio.json.internal

import scala.quoted._
import zio.json._
import zio.json.internal._
import scala.deriving.Mirror

object GhostProductDecoder {
  inline def derived[A](using m: Mirror.ProductOf[A]): JsonDecoder[A] = ${ deriveImpl[A]('m) }

  def deriveImpl[A: Type](m: Expr[Mirror.ProductOf[A]])(using Quotes): Expr[JsonDecoder[A]] = {
    import quotes.reflect._
    val tpe = TypeRepr.of[A]
    val fields = tpe.typeSymbol.caseFields
    val n = fields.size
    
    if (n > 64) report.errorAndAbort(s"Phantom optimization supports up to 64 fields. Found: $n")

    val matrix = Lexer.fieldMatrix(fields.map(_.name).toArray)
    val decoders = fields.map { f =>
      tpe.memberType(f).asType match {
        case '[t] => Expr.summon[JsonDecoder[t]].getOrElse(report.errorAndAbort(s"No Decoder for ${f.name}"))
      }
    }

    '{
      new JsonDecoder[A] {
        private val localMatrix = ${Expr(matrix)}
        private val allSetMask: Long = if (${Expr(n)} == 64) -1L else (1L << ${Expr(n)}) - 1L

        def decodeJson(trace: List[JsonError], in: RetractReader): Either[JsonError, A] = {
          val values = new Array[Any](${Expr(n)})
          var seenMask: Long = 0L 
          var error: JsonError = null

          ${
            val inits = fields.zipWithIndex.map { case (f, i) =>
              val fTpe = tpe.memberType(f)
              fTpe.asType match {
                case '[Int]     => '{ values(${Expr(i)}) = 0 }
                case '[Long]    => '{ values(${Expr(i)}) = 0L }
                case '[Double]  => '{ values(${Expr(i)}) = 0.0 }
                case '[Float]   => '{ values(${Expr(i)}) = 0.0f }
                case '[Boolean] => '{ values(${Expr(i)}) = false }
                case _          => '{ values(${Expr(i)}) = null }
              }
            }
            Block(inits.map(_.asTerm).toList, '{()}.asTerm).asExpr
          }

          if (Lexer.firstField(trace, in) != null) {
            var field: String = Lexer.lastFieldName
            while (field != null && error == null) {
              val idx = Lexer.fieldIndex(field, localMatrix)
              if (idx != -1) {
                val bit = 1L << idx
                if ((seenMask & bit) != 0L) error = JsonError.Message("Duplicate field: " + field) :: trace
                else {
                  seenMask |= bit
                  ${
                    val cases = fields.zipWithIndex.map { case (f, i) =>
                      CaseDef(Literal(IntConstant(i)), None, '{
                        ${decoders(i)}.decodeJson(trace, in) match {
                          case Right(v) => values(${Expr(i)}) = v
                          case Left(e) => error = e
                        }
                      }.asTerm)
                    } :+ CaseDef(Wildcard(), None, '{ Lexer.skipValue(trace, in) }.asTerm)
                    Match('{ idx }.asTerm, cases).asExpr
                  }
                }
              } else Lexer.skipValue(trace, in)
              if (error == null) field = Lexer.nextField(trace, in)
            }
          }

          if (error == null && (seenMask & allSetMask) != allSetMask) {
            ${
              val check = fields.zipWithIndex.collect {
                case (f, i) if !(tpe.memberType(f) <:< TypeRepr.of[Option[?]]) =>
                  '{ if ((seenMask & (1L << ${Expr(i)})) == 0L) error = JsonError.Message("Missing field: " + ${Expr(f.name)}) :: trace }
              }
              Block(check.map(_.asTerm).toList, '{()}.asTerm).asExpr
            }
          }

          if (error != null) Left(error)
          else Right($m.fromProduct(Tuple.fromArray(values).asInstanceOf[m.MirroredElemTypes]))
        }
      }
    }
  }
}
