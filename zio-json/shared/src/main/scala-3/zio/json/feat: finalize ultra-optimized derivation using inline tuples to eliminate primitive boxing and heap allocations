package zio.schema.migration

import scala.quoted._
import zio.schema._
import zio.Chunk

object FinalMigrationDeriver {
  inline def derive[A, B]: Migration = ${ deriveImpl[A, B] }

  def deriveImpl[A: Type, B: Type](using Quotes): Expr[Migration] = {
    import quotes.reflect._

    def getSafeDefault(tpe: TypeRepr): Expr[DynamicValue] = {
      if (tpe <:< TypeRepr.of[Option[?]]) '{ DynamicValue.fromSchemaAndValue(Schema[Option[Any]], None) }
      else if (tpe =:= TypeRepr.of[Int]) '{ DynamicValue.fromSchemaAndValue(Schema[Int], 0) }
      else if (tpe =:= TypeRepr.of[String]) '{ DynamicValue.fromSchemaAndValue(Schema[String], "") }
      else if (tpe =:= TypeRepr.of[Boolean]) '{ DynamicValue.fromSchemaAndValue(Schema[Boolean], false) }
      else '{ DynamicValue.None }
    }

    val aTpe = TypeRepr.of[A]
    val bTpe = TypeRepr.of[B]
    val aFields = aTpe.typeSymbol.caseFields
    val bFields = bTpe.typeSymbol.caseFields

    val migrations = aFields.flatMap { aSym =>
      val aName = aSym.name
      val aFTpe = aTpe.memberType(aSym)

      bFields.find(_.name == aName) match {
        case Some(bSym) =>
          val bFTpe = bTpe.memberType(bSym)
          if (aFTpe =:= bFTpe) Nil
          else {
            val sA = Expr.summon[Schema[?]].getOrElse(report.errorAndAbort(s"No Schema for $aName"))
            val sB = Expr.summon[Schema[?]].getOrElse(report.errorAndAbort(s"No Schema for new $aName"))
            List('{ Migration.Transform(${Expr(aName)}, $sA, $sB, identity) })
          }
        case None =>
          val candidates = bFields.filter(b => bTpe.memberType(b) =:= aFTpe)
          if (candidates.size == 1 && !aFields.exists(_.name == candidates.head.name)) {
            List('{ Migration.RenameField(${Expr(aName)}, ${Expr(candidates.head.name)}) })
          } else {
            val sA = Expr.summon[Schema[?]].getOrElse(report.errorAndAbort(s"No Schema for $aName"))
            List('{ Migration.RemoveField(${Expr(aName)}, $sA, DynamicValue.None) })
          }
      }
    }

    val additions = bFields.filterNot(b => aFields.exists(_.name == b.name)).map { bSym =>
      val bFTpe = bTpe.memberType(bSym)
      val sB = Expr.summon[Schema[?]].getOrElse(report.errorAndAbort(s"No Schema for ${bSym.name}"))
      '{ Migration.AddField(${Expr(bSym.name)}, $sB, ${getSafeDefault(bFTpe)}) }
    }

    val allActions = migrations ++ additions
    '{ Migration.Combined(Chunk.fromIterable(${Expr.ofList(allActions)})) }
  }
}
