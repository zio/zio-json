package zio.json.internal

import scala.quoted._
import zio.json._
import zio.json.internal._
import scala.deriving.Mirror

object GhostProductDecoder {
  inline def derived[A](using m: Mirror.ProductOf[A]): JsonDecoder[A] = ${ deriveImpl[A]('m) }

  def deriveImpl[A: Type](m: Expr[Mirror.ProductOf[A]])(using Quotes): Expr[JsonDecoder[A]] = {
    import quotes.reflect._

    val tpe = TypeRepr.of[A]
    val symbol = tpe.typeSymbol
    val fields = symbol.caseFields
    val n = fields.size

    // Safety check for bitmask capacity
    if (n > 64) report.errorAndAbort(s"Ghost optimization supports up to 64 fields. Found: $n")

    val matrix = Lexer.fieldMatrix(fields.map(_.name).toArray)
    val decoders = fields.map { f =>
      tpe.memberType(f).asType match {
        case '[t] => Expr.summon[JsonDecoder[t]].getOrElse(report.errorAndAbort(s"No Decoder for ${f.name}"))
      }
    }

    '{
      new JsonDecoder[A] {
        private val localMatrix = ${Expr(matrix)}
        private val allSetMask: Long = if (${Expr(n)} == 64) -1L else (1L << ${Expr(n)}) - 1L

        def decodeJson(trace: List[JsonError], in: RetractReader): Either[JsonError, A] = {
          var seenMask: Long = 0L
          var error: JsonError = null

          ${
            // 1. Safe Variable Generation using ValDef to avoid Scoping errors
            val varSymbols = fields.zipWithIndex.map { case (f, i) =>
              Symbol.newVar(Symbol.spliceOwner, s"v$i", tpe.memberType(f), Flags.Mutable, Symbol.noSymbol)
            }

            val varDefs = varSymbols.map { sym =>
              val fTpe = sym.termRef
              // Smarter defaults to prevent boxing and handle null safety
              val default = 
                if (fTpe <:< TypeRepr.of[Int]) Literal(IntConstant(0))
                else if (fTpe <:< TypeRepr.of[Long]) Literal(LongConstant(0L))
                else if (fTpe <:< TypeRepr.of[Double]) Literal(DoubleConstant(0.0))
                else if (fTpe <:< TypeRepr.of[Boolean]) Literal(BooleanConstant(false))
                else Literal(NullConstant()) // Non-primitives stay null until decoded
              ValDef(sym, Some(default))
            }

            // 2. Direct Assignment Case Blocks
            val cases = varSymbols.zipWithIndex.map { case (sym, i) =>
              val bit = 1L << i
              sym.termRef.asType match {
                case '[t] =>
                  CaseDef(Literal(IntConstant(i)), None, '{
                    if ((seenMask & ${Expr(bit)}) != 0L) {
                      error = JsonError.Message("Duplicate field: " + Lexer.lastFieldName) :: trace
                    } else {
                      seenMask |= ${Expr(bit)}
                      ${decoders(i)}.decodeJson(trace, in) match {
                        case Right(v) => ${ Assign(Ref(sym), '{v.asInstanceOf[t]}.asTerm).asExpr }
                        case Left(e) => error = e
                      }
                    }
                  }.asTerm)
              }
            }

            // 3. Precision Constructor: skips Mirror.fromProduct entirely
            val constructor = symbol.primaryConstructor
            val constructCall = Apply(Select(New(TypeTree.of[A]), constructor), varSymbols.map(Ref(_)))

            val body = '{
              if (Lexer.firstField(trace, in) != null) {
                while (Lexer.lastFieldName != null && error == null) {
                  val idx = Lexer.fieldIndex(Lexer.lastFieldName, localMatrix)
                  if (idx != -1) {
                    ${ Match('{ idx }.asTerm, (cases :+ CaseDef(Wildcard(), None, '{ Lexer.skipValue(trace, in) }.asTerm)).toList).asExpr }
                  } else Lexer.skipValue(trace, in)
                  
                  if (error == null) Lexer.nextField(trace, in)
                }
              }

              // Final bitwise validation for missing fields
              if (error == null && (seenMask & allSetMask) != allSetMask) {
                error = JsonError.Message("Missing required fields") :: trace
              }

              if (error != null) Left(error)
              else Right(${ constructCall.asExprOf[A] })
            }.asTerm

            Block(varDefs.toList, body).asExprOf[Either[JsonError, A]]
          }
        }
      }
    }
  }
}
